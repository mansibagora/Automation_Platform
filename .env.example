# Infrastructure Automation Portal - Environment Configuration Template
# Copy this file to backend/.env and update values for your environment.

# Server Port (Default: 8000)
PORTAL_PORT=8000

# SQLite Database File Path (relative to backend/ directory)
PORTAL_DB_PATH=portal.db

# GitHub Actions Integration (Optional - leave blank for simulated demo mode)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO=your-org-or-username/your-ansible-repo

# Application Security
PORTAL_SECRET_KEY=change-in-production-to-a-secure-random-string

# Designated Approver Identity (Must match username in users table)
DESIGNATED_APPROVER=approver_user

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
