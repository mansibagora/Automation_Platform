{
  "automations": [
    {
      "id": "hana-linux-start",
      "name": "HANA Start",
      "category": "SAP HANA",
      "os": "Linux",
      "action": "START",
      "description": "Start SAP HANA database instances and associated tenant services on Linux hosts.",
      "workflow_file": "hana_start.yml",
      "git_ref": "main",
      "enabled": true,
      "requires_configuration": false,
      "required_inputs": [
        {
          "name": "sid",
          "label": "System ID (SID)",
          "type": "string",
          "placeholder": "e.g. HDB, PRD",
          "regex": "^[A-Za-z0-9]{3}$",
          "description": "3-character SAP HANA System Identifier"
        },
        {
          "name": "instance_number",
          "label": "Instance Number",
          "type": "string",
          "placeholder": "e.g. 00, 01",
          "regex": "^[0-9]{2}$",
          "description": "2-digit HANA instance number"
        }
      ],
      "optional_inputs": [
        {
          "name": "target_host",
          "label": "Target Host / Inventory Group",
          "type": "string",
          "placeholder": "e.g. hana-node01.corp",
          "description": "Target server FQDN or inventory group (defaults to inventory mapping for SID)"
        }
      ],
      "github_input_mapping": {
        "sid": "sid",
        "action": "action",
        "instance_number": "instance_number",
        "target_host": "target_host"
      }
    },
